# The Hello My Cab backend — the same one the app and hellomycabs.com use. Only its
# /public/* endpoints are read here (fares, routes); nothing needs a token yet.
NEXT_PUBLIC_API_BASE_URL=https://api.hellomycabs.com/api/v1

# Canonical origin. Every absolute URL (metadata, sitemap, share images) is built from this,
# so it MUST be the exact host that is to be indexed.
NEXT_PUBLIC_SITE_URL=https://ghoomorajasthan.com

# Plausible's site domain (ghoomorajasthan.com). LEAVE EMPTY everywhere except production:
# empty means no script is loaded and no event is sent.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
