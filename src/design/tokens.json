  "alias": {
    "$comment": "Phase 0 names, kept so nothing breaks; new code uses the shades.",
    "royal": "royal-600",
    "maroon": "maroon-600",
    "gold": "gold-500",
    "sun": "sun-500",
    "sun-light": "sun-400",
    "sand": "sand-200"
  },
  "radius": { "sm": "8px", "md": "14px", "lg": "24px", "pill": "9999px" },
  "shadow": {
    "card": "0 1px 2px rgb(91 60 20 / .06), 0 4px 14px rgb(91 60 20 / .07)",
    "raised": "0 2px 4px rgb(91 60 20 / .08), 0 12px 32px rgb(91 60 20 / .12)"
  },
  "motion": {
    "ease-out": "cubic-bezier(.2,.8,.2,1)",
    "dur-fast": "150ms",
    "dur": "250ms",
    "dur-slow": "400ms"
  },
  "font": {
    "display": "Rozha One",
    "body": "Mukta"
  },
  "type": {
    "display": { "size": "clamp(2.25rem, 6vw + 1rem, 4rem)", "line": "1.1", "weight": "400", "family": "display" },
    "h1": { "size": "clamp(1.875rem, 4vw + 1rem, 3rem)", "line": "1.15", "weight": "400", "family": "display" },
    "h2": { "size": "clamp(1.5rem, 2.5vw + 1rem, 2.125rem)", "line": "1.2", "weight": "400", "family": "display" },
    "h3": { "size": "clamp(1.1875rem, 1vw + 1rem, 1.375rem)", "line": "1.3", "weight": "700", "family": "body" },
    "body-lg": { "size": "1.125rem", "line": "1.6", "weight": "400", "family": "body" },
    "body": { "size": "1.0625rem", "line": "1.6", "weight": "400", "family": "body" },
    "small": { "size": "0.875rem", "line": "1.5", "weight": "400", "family": "body" },
    "price": { "size": "clamp(1.375rem, 1vw + 1rem, 1.75rem)", "line": "1.2", "weight": "700", "family": "body" }
  },
  "layout": { "container": "72rem" }
}
