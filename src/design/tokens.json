    "$comment": "Phase 0 names, kept so nothing breaks; new code uses the shades.",
    "royal": "royal-600",
    "maroon": "maroon-600",
    "gold": "gold-500",
    "sun": "sun-500",
    "sun-light": "sun-400",
    "sand": "sand-200"
  },
  "radius": {
    "sm": "8px",
    "md": "14px",
    "lg": "24px",
    "pill": "9999px"
  },
  "shadow": {
    "card": "0 1px 2px rgb(91 60 20 / .06), 0 4px 14px rgb(91 60 20 / .07)",
    "raised": "0 2px 4px rgb(91 60 20 / .08), 0 12px 32px rgb(91 60 20 / .12)"
  },
  "motion": {
    "ease-out": "cubic-bezier(.2,.8,.2,1)",
    "dur-fast": "150ms",
    "dur": "250ms",
    "dur-slow": "400ms",
    "$scene": "Phase 4 (21 Oct 2026): the desert scene \u2014 slow, transform/opacity only, still under reduced motion (src/lib/motion.ts).",
    "ease-drift": "cubic-bezier(.45,0,.55,1)",
    "motion-dune": "45s",
    "motion-caravan": "32s",
    "motion-kite": "9s",
    "motion-shine": "0.8s",
    "motion-settle": "0.9s"
  },
  "font": {
    "display": "Rozha One",
    "body": "Mukta"
  },
  "type": {
