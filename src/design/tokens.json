    "royal-700": "#172E62",
    "royal-800": "#11224A",
    "maroon-50": "#FBEFEF",
    "maroon-100": "#F4D6D6",
    "maroon-500": "#A82424",
    "maroon-600": "#8E1B1B",
    "maroon-700": "#721515",
    "maroon-800": "#561010",
    "gold-100": "#FBF0D6",
    "gold-300": "#F0CC7E",
    "gold-500": "#E0A93B",
    "gold-600": "#C08A22",
    "gold-700": "#946A18",
    "sun-400": "#FFD27A",
    "sun-500": "#F5A623",
    "sand-50": "#FDF8EE",
    "sand-100": "#FAEDD2",
    "sand-200": "#F3D9A4",
    "sand-300": "#E9C47C",
    "ivory": "#FBF7EF",
    "ink": "#1B1B1F",
    "muted": "#5B5650",
    "success": "#1A6B44",
    "warning": "#F5A623",
    "danger": "#8E1B1B",
    "info": "#1E3A7B"
